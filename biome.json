{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignore": [
      "node_modules",
      ".next",
      "packages/tsconfig",
      "**/dist/**",
      "**/test-results/**",
      "**/playwright-report/**"
    ]
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "ignore": [],
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      }
    }
  },
  "formatter": {
    "indentStyle": "space"
  }
}
